# Copy to .env for local development. Never commit your real .env file.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=replace-this-with-at-least-32-random-characters
# Optional: set to true only if your database provider requires TLS but the URL omits sslmode.
DATABASE_SSL=false
PG_POOL_MAX=5
